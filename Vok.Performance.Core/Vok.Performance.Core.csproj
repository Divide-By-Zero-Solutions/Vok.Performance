<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Vok.Performance.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Divide-By-Zero-Solutions</Authors>
    <Company>Divide-By-Zero-Solutions</Company>
    <Description>Performance benchmarking attributes and utilities for Vok projects</Description>
    <PackageProjectUrl>https://github.com/Divide-By-Zero-Solutions/Vok.Performance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Divide-By-Zero-Solutions/Vok.Performance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageOutputPath>..\bin\Release</PackageOutputPath>
  </PropertyGroup>

</Project>
